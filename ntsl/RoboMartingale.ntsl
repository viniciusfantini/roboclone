// Robo martingale 1-3-9-27 (WINFUT / Profit Pro)
// Entra a mercado; gain fixo com ordem limite; stop fixo monitorado
// por tick e fechado a mercado. Stop triplica o proximo lote E SOMA
// IncrementoReforco (padrao 1) -- ex.: 1 -> 4 -> 13 -> 40 -- pra cada
// reforco cobrir a perda anterior com uma sobra de "IncrementoReforco"
// contratos, alem de inverter o lado. No nivel maximo, RepetirUltimoNivel
// decide se repete o mesmo tamanho ate' o gain (true) ou desiste e volta
// pro tamanho base (false). Gain reseta a progressao pra 1 mantendo o
// lado. Progressao reseta a cada novo dia de pregao. Plota em R$ (Plot1)
// quanto ja' foi perdido na sequencia atual e (Plot2) quanto se perderia
// a mais se a proxima entrada (no tamanho atual, incluindo repeticoes do
// nivel maximo) tambem tomar stop.

input
   PontosGain (50);
   PontosStop (100);
   QuantidadeBase (1);
   FatorMultiplicador (3);
   IncrementoReforco (1);
   NivelMaximo (4);
   RepetirUltimoNivel (true);
   LadoInicial (1);
   ValorPorPonto (0.20);

var
   Nivel                 : integer;
   LadoAtual             : integer;
   DiaAtual              : integer;
   QuantidadeAtual       : integer;
   PosicaoAbertaAnterior : boolean;
   StopAcionado          : boolean;
   PerdaAcumuladaRS      : float;
   PerdaProximoStopRS    : float;

begin
   // reseta a progressao a cada novo dia de pregao
   if (Date <> DiaAtual) then
   begin
      DiaAtual              := Date;
      Nivel                 := 1;
      LadoAtual             := 0;
      QuantidadeAtual       := QuantidadeBase;
      PosicaoAbertaAnterior := false;
      StopAcionado          := false;
      PerdaAcumuladaRS      := 0;
   end;

   // ==============================================
   // GERENCIAMENTO DA POSICAO COMPRADA
   // ==============================================
   if (IsBought = true) then
   begin
      if (Close <= buyprice - PontosStop) then
      begin
         ClosePosition;
         StopAcionado     := true;
         PerdaAcumuladaRS := PerdaAcumuladaRS + (PontosStop * BuyPositionQty * ValorPorPonto);
      end
      else
         SellToCoverLimit(buyprice + PontosGain, BuyPositionQty);

      PosicaoAbertaAnterior := true;
   end

   // ==============================================
   // GERENCIAMENTO DA POSICAO VENDIDA
   // ==============================================
   else if (IsSold = true) then
   begin
      if (Close >= sellprice + PontosStop) then
      begin
         ClosePosition;
         StopAcionado     := true;
         PerdaAcumuladaRS := PerdaAcumuladaRS + (PontosStop * SellPositionQty * ValorPorPonto);
      end
      else
         BuyToCoverLimit(sellprice - PontosGain, SellPositionQty);

      PosicaoAbertaAnterior := true;
   end

   // ==============================================
   // FLAT: atualiza a progressao (se acabou de fechar) e entra
   // ==============================================
   else
   begin
      if (PosicaoAbertaAnterior = true) then
      begin
         if (StopAcionado = true) then
         begin
            // so' cresce se ainda nao chegou no nivel maximo; no
            // nivel maximo, RepetirUltimoNivel decide se continua
            // repetindo o mesmo tamanho ate' o gain ou desiste e
            // volta pro tamanho base
            if (Nivel < NivelMaximo) then
            begin
               Nivel := Nivel + 1;
               QuantidadeAtual := QuantidadeAtual * FatorMultiplicador + IncrementoReforco;
            end
            else if (RepetirUltimoNivel = false) then
            begin
               Nivel := 1;
               QuantidadeAtual := QuantidadeBase;
            end;

            LadoAtual := -LadoAtual;
         end
         else
         begin
            Nivel            := 1;
            QuantidadeAtual  := QuantidadeBase;
            PerdaAcumuladaRS := 0;
         end;

         StopAcionado          := false;
         PosicaoAbertaAnterior := false;
      end;

      if (LadoAtual = 0) then
         LadoAtual := LadoInicial;

      if (LadoAtual = 1) then
         BuyAtMarket(QuantidadeAtual)
      else
         SellShortAtMarket(QuantidadeAtual);
   end;

   // exibe no grafico quanto ja' foi perdido (R$) na sequencia atual e
   // quanto se perderia a mais se a operacao no tamanho atual tomar stop
   PerdaProximoStopRS := QuantidadeAtual * PontosStop * ValorPorPonto;
   Plot1(PerdaAcumuladaRS);
   Plot2(PerdaProximoStopRS);
end;
