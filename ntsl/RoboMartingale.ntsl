// Robo martingale 1-3-9-27 (WINFUT / Profit Pro)
// Entra a mercado; gain fixo com ordem limite; stop fixo monitorado
// por tick e fechado a mercado. Stop triplica o proximo lote e
// inverte o lado; gain reseta a progressao pra 1 mantendo o lado.
// Progressao reseta a cada novo dia de pregao.

input
   PontosGain (50);
   PontosStop (100);
   QuantidadeBase (1);
   FatorMultiplicador (3);
   NivelMaximo (4);
   LadoInicial (1);

var
   Nivel                 : integer;
   LadoAtual             : integer;
   DiaAtual              : integer;
   QuantidadeAtual       : integer;
   PosicaoAbertaAnterior : boolean;
   StopAcionado          : boolean;
   i                     : integer;

begin
   // reseta a progressao a cada novo dia de pregao
   if (Date <> DiaAtual) then
   begin
      DiaAtual              := Date;
      Nivel                 := 1;
      LadoAtual             := 0;
      PosicaoAbertaAnterior := false;
      StopAcionado          := false;
   end;

   // ==============================================
   // GERENCIAMENTO DA POSICAO COMPRADA
   // ==============================================
   if (IsBought = true) then
   begin
      if (Close <= buyprice - PontosStop) then
      begin
         ClosePosition;
         StopAcionado := true;
      end
      else
         SellToCoverLimit(buyprice + PontosGain, BuyPositionQty);

      PosicaoAbertaAnterior := true;
   end

   // ==============================================
   // GERENCIAMENTO DA POSICAO VENDIDA
   // ==============================================
   else if (IsSold = true) then
   begin
      if (Close >= sellprice + PontosStop) then
      begin
         ClosePosition;
         StopAcionado := true;
      end
      else
         BuyToCoverLimit(sellprice - PontosGain, SellPositionQty);

      PosicaoAbertaAnterior := true;
   end

   // ==============================================
   // FLAT: atualiza a progressao (se acabou de fechar) e entra
   // ==============================================
   else
   begin
      if (PosicaoAbertaAnterior = true) then
      begin
         if (StopAcionado = true) then
         begin
            if (Nivel < NivelMaximo) then
               Nivel := Nivel + 1;
            LadoAtual := -LadoAtual;
         end
         else
            Nivel := 1;

         StopAcionado          := false;
         PosicaoAbertaAnterior := false;
      end;

      if (LadoAtual = 0) then
         LadoAtual := LadoInicial;

      QuantidadeAtual := QuantidadeBase;
      for i := 2 to Nivel do
         QuantidadeAtual := QuantidadeAtual * FatorMultiplicador;

      if (LadoAtual = 1) then
         BuyAtMarket(QuantidadeAtual)
      else
         SellShortAtMarket(QuantidadeAtual);
   end;
end;
