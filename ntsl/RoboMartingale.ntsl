begin
    input
        PontosGain(50);
        PontosStop(100);
        QuantidadeBase(1);
        FatorMultiplicador(3);
        NivelMaximo(4);
        LadoInicial(1);

    var
        Nivel(1);
        LadoAtual(0);
        DiaAtual(0);
        PrecoEntrada(0.0);
        QuantidadeAtual(0);
        EntradaPendente(false);
        ResultadoPendente(0);
        i(0);

    // reseta a progressao a cada novo dia de pregao
    if Date <> DiaAtual then
    begin
        DiaAtual := Date;
        Nivel := 1;
        LadoAtual := 0;
        EntradaPendente := false;
        ResultadoPendente := 0;
    end;

    if HasPosition then
    begin
        EntradaPendente := false;

        if LadoAtual = 1 then
        begin
            if Close >= PrecoEntrada + PontosGain then
            begin
                SellToClose(QuantidadeAtual);
                ResultadoPendente := 1;
            end
            else if Close <= PrecoEntrada - PontosStop then
            begin
                SellToClose(QuantidadeAtual);
                ResultadoPendente := -1;
            end;
        end
        else if LadoAtual = -1 then
        begin
            if Close <= PrecoEntrada - PontosGain then
            begin
                BuyToCover(QuantidadeAtual);
                ResultadoPendente := 1;
            end
            else if Close >= PrecoEntrada + PontosStop then
            begin
                BuyToCover(QuantidadeAtual);
                ResultadoPendente := -1;
            end;
        end;
    end
    else
    begin
        // acabou de fechar a posicao (gain ou stop) -> atualiza a progressao
        // ANTES de decidir o tamanho/lado da proxima entrada
        if ResultadoPendente <> 0 then
        begin
            if ResultadoPendente = 1 then
                Nivel := 1
            else
            begin
                if Nivel < NivelMaximo then
                    Nivel := Nivel + 1;
                LadoAtual := -LadoAtual;
            end;

            ResultadoPendente := 0;
        end;

        if not EntradaPendente then
        begin
            if LadoAtual = 0 then
                LadoAtual := LadoInicial;

            QuantidadeAtual := QuantidadeBase;
            for i := 2 to Nivel do
                QuantidadeAtual := QuantidadeAtual * FatorMultiplicador;

            if LadoAtual = 1 then
                BuyToOpen(QuantidadeAtual)
            else
                SellShortToOpen(QuantidadeAtual);

            PrecoEntrada := Close;
            EntradaPendente := true;
        end;
    end;
end;
